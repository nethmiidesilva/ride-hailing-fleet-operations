{
  "uid": "fleet-health",
  "title": "Pipeline Health",
  "tags": [
    "fleet",
    "observability",
    "sre"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Operational view of the pipeline itself: is data flowing, is it being processed fast enough, is anything being quarantined, and did the nightly reconciliation run?",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Telemetry age (s)",
      "description": "time() - producer_last_send_timestamp. The NoTelemetryReceived alert fires above 120 s.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - producer_last_send_timestamp",
          "legendFormat": "producer"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last micro-batch age (s)",
      "description": "time() - stream_last_batch_timestamp. StreamProcessingStalled fires above 120 s.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - stream_last_batch_timestamp",
          "legendFormat": "stream"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Expense file age (s)",
      "description": "ExpenseFileLate fires above 1.5 simulated days (900 s).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 700
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - expense_last_file_timestamp",
          "legendFormat": "expenses"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API health",
      "description": "1 = healthy, 0 = degraded (Postgres down, Kafka unreachable, or data stale).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DEGRADED",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "api_health_status"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Prometheus targets up",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Producer event rate (events/s by status)",
      "description": "Ingestion throughput. A flat line at zero is the NoTelemetryReceived failure mode.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(producer_events_sent_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Streaming lag (broker offset \u2212 committed offset)",
      "description": "Spark Structured Streaming keeps offsets in its checkpoint, not in a Kafka consumer group, so kafka_consumergroup_lag is always empty for this job. True lag is the broker's end offset minus the offset the job has committed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_topic_partition_current_offset{topic=\"fleet.telemetry\"}) - sum(max by (partition) (stream_committed_offset{topic=\"fleet.telemetry\"}))",
          "legendFormat": "lag (messages)"
        },
        {
          "refId": "B",
          "expr": "sum(stream_input_rows_per_second)",
          "legendFormat": "input rows/s"
        },
        {
          "refId": "C",
          "expr": "sum(stream_processed_rows_per_second)",
          "legendFormat": "processed rows/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Micro-batch duration (p50 / p95) by sink",
      "description": "StreamBatchSlow fires when p95 exceeds 20 s against a 30 s trigger.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(stream_batch_duration_seconds_bucket[5m])) by (le, sink))",
          "legendFormat": "p50 {{sink}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(stream_batch_duration_seconds_bucket[5m])) by (le, sink))",
          "legendFormat": "p95 {{sink}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rejected rows by reason (rows/s)",
      "description": "Data-quality signal. HighRejectRate fires when the reject ratio exceeds 5%.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(stream_rows_rejected_total[2m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Reject ratio (alert expression)",
      "description": "The exact expression behind HighRejectRate, so the threshold can be seen crossing during the chaos demo.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(stream_rows_rejected_total[2m])) / clamp_min(sum(rate(stream_events_valid_total[2m])) + sum(rate(stream_rows_rejected_total[2m])), 0.001)",
          "legendFormat": "reject ratio"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Airflow DAG runs (pipeline_runs)",
      "description": "Orchestration status written by the record_pipeline_run task; the audit trail of which simulated days were reconciled.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "postgres",
        "uid": "fleet-postgres"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      },
                      "running": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT report_date, run_id, status, started_at, finished_at, duration_s, rows_written FROM pipeline_runs ORDER BY started_at DESC LIMIT 20;"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Pipeline alerts (orchestration failures)",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "postgres",
        "uid": "fleet-postgres"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at, alert_name, severity, dag_id, task_id, report_date, message FROM pipeline_alerts ORDER BY created_at DESC LIMIT 20;"
        }
      ]
    }
  ]
}
