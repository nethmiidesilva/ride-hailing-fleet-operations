# ============================================================================
# fleet-lambda — single source of truth for configuration.
# Copy to .env (`make env` or `cp .env.example .env`) before `docker compose up`.
# Every variable is read in common/config.py; nothing is hard-coded in business code.
# ============================================================================

# --- Simulated clock -------------------------------------------------------
# 1 simulated day compresses into SIM_DAY_SECONDS real seconds (600 = 10 min).
SIM_DAY_SECONDS=600
SIM_START_DATE=2026-09-01
# Written once by the first service that starts; every service then agrees on the epoch.
SIM_EPOCH_FILE=/shared/sim_epoch.txt

# --- Determinism -----------------------------------------------------------
SEED=42

# --- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=fleet.telemetry
KAFKA_DLQ_TOPIC=fleet.telemetry.dlq
KAFKA_PARTITIONS=6
KAFKA_REPLICATION=1
KAFKA_CONSUMER_GROUP=fleet-stream

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
# Airflow keeps its metadata in a separate database on the same server (saves RAM).
AIRFLOW_DB=airflow

# --- Fleet simulation ------------------------------------------------------
NUM_VEHICLES=25
EMIT_INTERVAL_SEC=2
EMIT_JITTER_SEC=0.5
LAZY_VEHICLES=3
# Fault injection rates — these make the processing layer meaningful.
BAD_EVENT_RATE=0.02
LATE_EVENT_RATE=0.01
DUPLICATE_RATE=0.01
LATE_EVENT_MIN_SEC=30
LATE_EVENT_MAX_SEC=90

# --- Fare model (LKR) ------------------------------------------------------
FARE_BASE_LKR=150
FARE_PER_KM_LKR=100
FARE_NOISE_PCT=0.08

# --- Daily expense file (batch source), calibrated so some vehicles lose money ---------------
EXPENSE_FUEL_PER_KM_LKR=45
EXPENSE_DISTANCE_MIN_KM=2.5
EXPENSE_DISTANCE_MAX_KM=9.0
EXPENSE_MAINT_NORMAL_MIN=80
EXPENSE_MAINT_NORMAL_MAX=420
EXPENSE_MAINT_HIGH_MIN=1500
EXPENSE_MAINT_HIGH_MAX=4200
EXPENSE_HIGH_COST_PCT=0.15
EXPENSE_DIRTY_ROWS=2

# --- Zones (Colombo bounding box, 3 cols x 2 rows) -------------------------
ZONE_LAT_MIN=6.86
ZONE_LAT_MAX=6.98
ZONE_LON_MIN=79.84
ZONE_LON_MAX=79.90

# --- Streaming -------------------------------------------------------------
SPARK_MASTER=local[*]
STREAM_STARTING_OFFSETS=latest
STREAM_WINDOW_MINUTES=1
STREAM_WATERMARK_MINUTES=2
STREAM_TRIGGER_SECONDS=30
CHECKPOINT_ROOT=/data/checkpoints
LAKE_ROOT=/data/lake
LANDING_DIR=/data/landing
PROCESSED_DIR=/data/processed
REPORTS_DIR=/data/reports

# --- Alerting thresholds ---------------------------------------------------
IDLE_ALERT_MINUTES=3
MARGIN_THRESHOLD=0.10
FRESHNESS_SECONDS=120
MAX_BAD_EXPENSE_ROW_PCT=0.20

# --- Ports (host side) -----------------------------------------------------
API_PORT=8000
PRODUCER_METRICS_PORT=8001
EXPENSE_METRICS_PORT=8002
STREAM_METRICS_PORT=8003
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Airflow UI. 8080 is commonly taken on a developer laptop (it was on the build machine),
# so the default here is 8082. The container still listens on 8080 internally.
AIRFLOW_PORT=8082
KAFKA_EXPORTER_PORT=9308

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Grafana ---------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Airflow ---------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=False
