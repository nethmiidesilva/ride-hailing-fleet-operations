/*
 * Storage schema (ERD-style).  Render: dot -Tpng data_model.dot -o data_model.png
 */
digraph DataModel {
  rankdir=LR;
  bgcolor="white";
  fontname="Helvetica";
  labelloc="t";
  label="PostgreSQL serving schema — every table has a natural PK so every write is an idempotent UPSERT";
  fontsize=11;
  node [shape=plaintext, fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8, color="#5b6b7a"];

  /* ---------------- speed layer ---------------- */
  rzm [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#d7f3f3" COLSPAN="2"><B>realtime_zone_metrics</B><BR/><FONT POINT-SIZE="7">SPEED LAYER</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>window_start</B></TD><TD ALIGN="LEFT">timestamptz PK</TD></TR>
      <TR><TD ALIGN="LEFT"><B>zone</B></TD><TD ALIGN="LEFT">text PK</TD></TR>
      <TR><TD ALIGN="LEFT">window_end</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
      <TR><TD ALIGN="LEFT">active/idle/total_vehicles</TD><TD ALIGN="LEFT">int (approx)</TD></TR>
      <TR><TD ALIGN="LEFT">idle_ratio</TD><TD ALIGN="LEFT">numeric (event share)</TD></TR>
      <TR><TD ALIGN="LEFT">trips_completed</TD><TD ALIGN="LEFT">int</TD></TR>
      <TR><TD ALIGN="LEFT">earnings_lkr</TD><TD ALIGN="LEFT">numeric</TD></TR>
      <TR><TD ALIGN="LEFT">avg_speed_kmh / event_count</TD><TD ALIGN="LEFT">numeric / int</TD></TR>
    </TABLE>>];

  vs [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#d7f3f3" COLSPAN="2"><B>vehicle_status</B><BR/><FONT POINT-SIZE="7">SPEED LAYER · latest event wins</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>vehicle_id</B></TD><TD ALIGN="LEFT">text PK</TD></TR>
      <TR><TD ALIGN="LEFT">driver_id / status / zone</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD ALIGN="LEFT">lat / lon / speed_kmh</TD><TD ALIGN="LEFT">double</TD></TR>
      <TR><TD ALIGN="LEFT">last_event_time</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
      <TR><TD ALIGN="LEFT">idle_since</TD><TD ALIGN="LEFT">timestamptz (sticky)</TD></TR>
    </TABLE>>];

  ia [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fbe9e9" COLSPAN="2"><B>idle_alerts</B><BR/><FONT POINT-SIZE="7">threshold alert</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigserial PK</TD></TR>
      <TR><TD ALIGN="LEFT">vehicle_id</TD><TD ALIGN="LEFT">text FK→vehicle_status</TD></TR>
      <TR><TD ALIGN="LEFT">idle_since / detected_at</TD><TD ALIGN="LEFT">timestamptz</TD></TR>
      <TR><TD ALIGN="LEFT">resolved_at / idle_minutes</TD><TD ALIGN="LEFT">timestamptz / numeric</TD></TR>
      <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">open | resolved</TD></TR>
      <TR><TD BGCOLOR="#fff5e6" ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="7">UNIQUE (vehicle_id) WHERE status='open'<BR/>→ one open alert per vehicle</FONT></TD></TR>
    </TABLE>>];

  re [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fbe9e9" COLSPAN="2"><B>rejected_events</B><BR/><FONT POINT-SIZE="7">quarantine</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigserial PK</TD></TR>
      <TR><TD ALIGN="LEFT">event_id / vehicle_id</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD ALIGN="LEFT">raw_payload</TD><TD ALIGN="LEFT">text</TD></TR>
      <TR><TD ALIGN="LEFT">kafka_partition / offset</TD><TD ALIGN="LEFT">int / bigint</TD></TR>
    </TABLE>>];

  /* ---------------- batch layer ---------------- */
  de [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fdf0d5" COLSPAN="2"><B>daily_expenses</B><BR/><FONT POINT-SIZE="7">BATCH SOURCE</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>report_date</B></TD><TD ALIGN="LEFT">date PK</TD></TR>
      <TR><TD ALIGN="LEFT"><B>vehicle_id</B></TD><TD ALIGN="LEFT">text PK</TD></TR>
      <TR><TD ALIGN="LEFT">fuel_cost / maintenance_cost</TD><TD ALIGN="LEFT">numeric</TD></TR>
      <TR><TD ALIGN="LEFT">distance_covered</TD><TD ALIGN="LEFT">numeric</TD></TR>
      <TR><TD ALIGN="LEFT">service_flag</TD><TD ALIGN="LEFT">smallint</TD></TR>
      <TR><TD ALIGN="LEFT">source_file / run_id</TD><TD ALIGN="LEFT">text</TD></TR>
    </TABLE>>];

  dvp [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fdf0d5" COLSPAN="2"><B>daily_vehicle_profitability</B><BR/><FONT POINT-SIZE="7">BATCH LAYER · THE ANSWER</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>report_date</B></TD><TD ALIGN="LEFT">date PK</TD></TR>
      <TR><TD ALIGN="LEFT"><B>vehicle_id</B></TD><TD ALIGN="LEFT">text PK</TD></TR>
      <TR><TD ALIGN="LEFT">revenue_lkr / trips</TD><TD ALIGN="LEFT">recomputed from Parquet</TD></TR>
      <TR><TD ALIGN="LEFT">active/idle_minutes, utilization</TD><TD ALIGN="LEFT">numeric</TD></TR>
      <TR><TD ALIGN="LEFT">fuel/maintenance/total_cost</TD><TD ALIGN="LEFT">from daily_expenses</TD></TR>
      <TR><TD ALIGN="LEFT">profit_lkr / margin</TD><TD ALIGN="LEFT">numeric (NULL-guarded)</TD></TR>
      <TR><TD ALIGN="LEFT">cost_per_km / revenue_per_km</TD><TD ALIGN="LEFT">numeric</TD></TR>
      <TR><TD ALIGN="LEFT">is_unprofitable</TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD ALIGN="LEFT">trend</TD><TD ALIGN="LEFT">STABLE|DECLINING|AT_RISK</TD></TR>
      <TR><TD ALIGN="LEFT">data_quality_flag</TD><TD ALIGN="LEFT">OK|MISSING_EXPENSE|NO_TELEMETRY</TD></TR>
    </TABLE>>];

  dzs [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#fdf0d5" COLSPAN="2"><B>daily_zone_summary</B><BR/><FONT POINT-SIZE="7">BATCH LAYER · exact counterpart of realtime_zone_metrics</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>report_date, zone, sim_hour</B></TD><TD ALIGN="LEFT">PK</TD></TR>
      <TR><TD ALIGN="LEFT">trips / earnings_lkr</TD><TD ALIGN="LEFT">int / numeric</TD></TR>
      <TR><TD ALIGN="LEFT">active/idle_events</TD><TD ALIGN="LEFT">int</TD></TR>
      <TR><TD ALIGN="LEFT">utilization / avg_speed_kmh</TD><TD ALIGN="LEFT">numeric</TD></TR>
    </TABLE>>];

  pr [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#f0e9f7" COLSPAN="2"><B>pipeline_runs</B> / <B>pipeline_alerts</B><BR/><FONT POINT-SIZE="7">ORCHESTRATION AUDIT</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>run_id</B></TD><TD ALIGN="LEFT">text PK</TD></TR>
      <TR><TD ALIGN="LEFT">report_date / status</TD><TD ALIGN="LEFT">date / text</TD></TR>
      <TR><TD ALIGN="LEFT">started/finished_at, duration_s</TD><TD ALIGN="LEFT">timestamptz / numeric</TD></TR>
      <TR><TD ALIGN="LEFT">rows_written</TD><TD ALIGN="LEFT">jsonb</TD></TR>
    </TABLE>>];

  views [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#e9f7ef"><B>VIEWS</B></TD></TR>
      <TR><TD ALIGN="LEFT">v_fleet_now — counts from vehicle_status,<BR/>money from the latest window</TD></TR>
      <TR><TD ALIGN="LEFT">v_unprofitable_vehicles — latest day,<BR/>is_unprofitable OR trend ≠ STABLE</TD></TR>
      <TR><TD ALIGN="LEFT">v_data_quality_today — rejects by reason</TD></TR>
    </TABLE>>];

  vs  -> ia  [label="1 : N"];
  de  -> dvp [label="joined on\nvehicle_id"];
  dvp -> views [style=dashed];
  vs  -> views [style=dashed];
  rzm -> views [style=dashed];
  dvp -> dzs [style=invis];
  pr  -> dvp [style=dotted, label="run_id\ntraces the run"];
  re  -> rzm [style=invis];
}
